import torch

print("=== 2.1 Градиенты функции f(x, y, z) ===")
# f(x, y, z) = x^2 + y^2 + z^2 + 2*x*y*z
x = torch.tensor(2.0, requires_grad=True)
y = torch.tensor(3.0, requires_grad=True)
z = torch.tensor(4.0, requires_grad=True)

f = x**2 + y**2 + z**2 + 2 * x * y * z
f.backward()

print(f"Значение функции f: {f.item()}")
print(f"Численный df/dx: {x.grad.item()} | Аналитический (2x + 2yz): {2*2.0 + 2*3.0*4.0}")
print(f"Численный df/dy: {y.grad.item()} | Аналитический (2y + 2xz): {2*3.0 + 2*2.0*4.0}")
print(f"Численный df/dz: {z.grad.item()} | Аналитический (2z + 2xy): {2*4.0 + 2*2.0*3.0}")


print("\n=== 2.2 Градиент функции потерь (MSE) ===")
# Модель: y_pred = w * x + b
# Ошибка: MSE = (1/n) * sum((y_pred - y_true)^2)
x_data = torch.tensor([1.0, 2.0, 3.0])
y_true = torch.tensor([3.0, 5.0, 7.0])  # целевая зависимость y = 2x + 1

w = torch.tensor(0.5, requires_grad=True)
b = torch.tensor(0.0, requires_grad=True)

# Прямой проход (forward)
y_pred = w * x_data + b
loss = ((y_pred - y_true) ** 2).mean()

# Обратный проход (backward)
loss.backward()

print(f"Loss: {loss.item():.4f}")
print(f"Градиент dLoss/dw: {w.grad.item():.4f}")
print(f"Градиент dLoss/db: {b.grad.item():.4f}")


print("\n=== 2.3 Цепное правило (Chain Rule) ===")
# f(x) = sin(x^2 + 1)
# df/dx = cos(x^2 + 1) * 2x
x_val = torch.tensor(1.5, requires_grad=True)
f_val = torch.sin(x_val**2 + 1)

# Вычисление через torch.autograd.grad
grad_autograd = torch.autograd.grad(f_val, x_val, retain_graph=True)[0]
analytical_grad = torch.cos(x_val**2 + 1) * (2 * x_val)

print(f"Градиент через autograd: {grad_autograd.item():.4f}")
print(f"Градиент аналитический:  {analytical_grad.item():.4f}")
